# ==============================================================================
# Angus Masail - Production Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env on your AWS EC2 instance:
#   cp .env.example .env
#   nano .env
# ==============================================================================

# Docker image deployed from CI/CD
DOCKER_IMAGE=codominator/angusmasail-backend:latest

# Spring Profile (always prod for live deployment)
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Credentials
DB_PASSWORD=YourStrongDatabasePasswordHere_123!

# JWT Secret Key (min 256-bit / 64 characters recommended for HMAC-SHA256)
APP_JWT_SECRET=4b29bb88b3f81e3a6c813589b276707328ff9029a1b8ed83427f8a7e0892c575a89f9202a

# Super Admin Initial Accounts (email:password:name:phone, comma-separated)
APP_ADMIN_USERS=admin@angusmasail.com:Admin@123:Super Admin:9999999999

# Email / SMTP Configuration (for password resets, OTP, notifications)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Host Port (default 80 and 443 handled by Nginx)
PORT=8080
