# ==============================================================================
# Angus Masail - Production Environment Variables (.env)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOCKER
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
DOCKER_IMAGE=codominator/angusmasail-backend:latest
PORT=8080

# ------------------------------------------------------------------------------
# 2. EXTERNAL / CLOUD POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Example: jdbc:postgresql://ep-example.eu-central-1.aws.neon.tech/angusmasail?sslmode=require
# Or standard: jdbc:postgresql://your-db-host.com:5432/angusmasail
SPRING_DATASOURCE_URL=jdbc:postgresql://your-cloud-postgres-host:5432/angusmasail
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YourSecureDatabasePassword123!

# Optional pool configuration
DB_POOL_MAX=20
DB_POOL_MIN=5

# ------------------------------------------------------------------------------
# 3. EXTERNAL / CLOUD REDIS CACHE
# ------------------------------------------------------------------------------
# Example: Upstash, Layerbase, Redis Cloud, or AWS ElastiCache
SPRING_DATA_REDIS_HOST=your-redis-host.cloud.layerbase.dev
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=YourRedisPasswordHere

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# 256-bit hexadecimal string for JWT token signing
APP_JWT_SECRET=4b29bb88b3f81e3a6c813589b276707328ff9029a1b8ed83427f8a7e0892c575a89f9202a
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# Super Admin User Configuration (Either format works):
# Format A (Single line): email:password:FullName:PhoneNumber (comma-separated for multiple)
APP_ADMIN_USERS=admin@angusmasail.com:Admin@123:Super Admin:9999999999

# Format B (Alternative individual keys):
# ADMIN_EMAIL=admin@angusmasail.com
# ADMIN_PASSWORD=Admin@123
# ADMIN_NAME=Super Admin
# ADMIN_PHONE=9999999999

# ------------------------------------------------------------------------------
# 5. GMAIL / SMTP EMAIL DISPATCH (For OTP & Notifications)
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
# 16-character Google App Password from: https://myaccount.google.com/apppasswords
SPRING_MAIL_PASSWORD=your-16-char-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
