DB_PASSWORD=password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/angusmasail
SPRING_DATASOURCE_USERNAME=postgres

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

APP_JWT_SECRET=4b29bb88b3f81e3a6c813589b276707328ff9029a1b8ed83427f8a7e0892c575a89f9202a

# SMTP Email Credentials (e.g., Gmail, SendGrid, Mailgun)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password_here
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Administrator Credentials (can be one or more admins)
# Format: email:password:name:phone, separated by comma for multiple admins
APP_ADMIN_USERS=admin@angusmasail.com:Admin@123:Super Admin:9999999999
