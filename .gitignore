# ====================================================================
# Android & Spring Boot Fullstack .gitignore
# ====================================================================

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Java class & package files
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
# Except gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar
!backend/gradle/wrapper/gradle-wrapper.jar

# Build & generated directories
bin/
gen/
out/
build/
*/build/
app/build/
backend/build/
captures/
buildOutputCleanup/

# Gradle files
.gradle/
*/.gradle/
backend/.gradle/
gradle/wrapper/gradle-wrapper.jar.sha256

# Kotlin
.kotlin/
.kotlin-daemon/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Android Studio
proguard/

# Log files
*.log

# Android Studio & IntelliJ IDEA
*.iml
.idea/
*/.idea/
backend/.idea/
.idea_modules/

# Keystore files
*.jks
*.keystore

# Google Services (Firebase)
google-services.json

# Native build
.externalNativeBuild
.cxx/

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backend runtime files & uploads
backend/uploads/*
!backend/uploads/.gitkeep
backend/quran_cache/*
!backend/quran_cache/.gitkeep
uploads/
quran_cache/

# Certbot live certs (production)
docker/certbot/
!docker/certbot/.gitkeep

# Environment files
.env
.env.local

som.txt
